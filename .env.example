# Discord token of the app
APP_TOKEN=

# Invite URL of the support server
DISCORD_SERVER_INVITE=

# Your discord ID
DEVELOPER_ID=

# Groq API key
GROQ_API_KEY=

# Groq model used for answers
GROQ_MODEL=llama-3.3-70b-versatile

# Primary URL for Rewrite llm spec
LLM_SPEC_URL=https://www.rewritetoday.com/llms.txt

# Redis host used by BullMQ
REDIS_HOST=127.0.0.1

# Redis port used by BullMQ
REDIS_PORT=6379

# Redis password used by BullMQ
REDIS_PASSWORD=redis_password
