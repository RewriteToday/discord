# Discord token of the app
APP_TOKEN=

# Array of IDs (Developers)
TEAM_MEMBERS_ID=[]

# Groq API key
GROQ_API_KEY=

# Fallback Groq API keys (JSON array)
GROQ_FALLBACK_API_KEYS=[]

# Groq model used for answers
GROQ_MODEL=llama-3.3-70b-versatile

# Primary URL for Rewrite llm spec
LLM_SPEC_URL=https://www.rewritetoday.com/llms.txt

# Redis host used by BullMQ
REDIS_HOST=127.0.0.1

# Redis port used by BullMQ
REDIS_PORT=6379

# Redis password used by BullMQ
REDIS_PASSWORD=redis_password
