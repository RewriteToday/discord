{
	"name": "rewrite",
	"module": "src/index.ts",
	"type": "module",
	"private": true,
	"devDependencies": {
		"@biomejs/biome": "^2.4.4",
		"@commitlint/config-conventional": "^20.4.2",
		"@types/bun": "latest",
		"commitlint": "^20.4.2"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"bullmq": "^5.70.1",
		"envalid": "^8.1.1",
		"seyfert": "^4.2.2"
	},
	"scripts": {
		"biome:check": "biome check --write .",
		"typecheck": "bunx tsc --noEmit",
		"client": "bun run src/index.ts",
		"client:compile": "bun build --compile --minify --target bun-linux-x64 --outfile app ./src/index.ts"
	}
}
