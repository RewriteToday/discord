{
	"name": "rewrite",
	"module": "src/index.ts",
	"type": "module",
	"private": true,
	"devDependencies": {
		"@biomejs/biome": "^2.4.9",
		"@commitlint/config-conventional": "^20.5.0",
		"@types/bun": "^1.3.11",
		"commitlint": "^20.5.0"
	},
	"peerDependencies": {
		"typescript": "^6.0.2"
	},
	"dependencies": {
		"bullmq": "^5.71.1",
		"envalid": "^8.1.1",
		"seyfert": "^4.2.2"
	},
	"scripts": {
		"biome:check": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"client": "bun --watch src/index.ts",
		"client:compile": "bun build src/index.ts src/client/commands/*.ts src/client/events/*.ts --root src --outdir dist --format=esm --target=node --sourcemap"
	}
}
